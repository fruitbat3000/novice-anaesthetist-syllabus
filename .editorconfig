# Consistent formatting across editors — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown: keep trailing spaces off, but do not touch hard line breaks awkwardly
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
